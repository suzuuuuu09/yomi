{
  "name": "yomi-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "next dev",
    "dev:cf": "npx @cloudflare/next-on-pages@1 && wrangler pages dev .vercel/output/static",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:app": "biome check src/app src/hooks src/lib/api-client.ts src/lib/api.ts src/server src/store src/types tests vitest.config.mts src/components/SessionGuard.tsx src/components/sections/AddBookModal.tsx src/components/shares/UserMenu.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "fix": "biome check --write",
    "format": "biome format --write",
    "add": "liftkit add"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@material/material-color-utilities": "^0.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.21.3",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "lucide-react": "^0.575.0",
    "material-dynamic-colors": "^1.1.4",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.0",
    "wrangler": "^4.115.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@chainlift/liftkit": "^0.2.0",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@pandacss/dev": "^1.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
