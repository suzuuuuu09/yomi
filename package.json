{
  "name": "yomi-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev",
    "dev:cf": "vite dev",
    "db:migrate:local": "bash scripts/migrate-d1.sh --local",
    "db:migrate:remote": "bash scripts/migrate-d1.sh --remote",
    "db:check-schema:local": "bash scripts/check-d1-schema.sh --local",
    "build": "vite build",
    "start": "vite preview",
    "lint": "biome check",
    "lint:app": "biome check src/app src/hooks src/lib/api-client.ts src/lib/api.ts src/server src/store src/types tests vitest.config.mts src/components/SessionGuard.tsx src/components/sections/AddBookModal.tsx src/components/shares/UserMenu.tsx vite.config.ts src/proxy.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "fix": "biome check --write",
    "format": "biome format --write",
    "add": "liftkit add",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.8.2",
    "@zxing/library": "^0.21.3",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.14",
    "lucide-react": "^0.575.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "three": "^0.186.0",
    "vinext": "^1.3.1",
    "wrangler": "^4.152.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@chainlift/liftkit": "^0.2.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@pandacss/dev": "^1.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vite-css-modules": "^1.16.0",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
