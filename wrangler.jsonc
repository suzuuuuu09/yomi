{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema/v2.0.0/wrangler.schema.json",
  "name": "yomi",
  "compatibility_date": "2026-02-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "d1_databases": [
    {
      "binding": "yomi_db",
      "database_name": "yomi-db",
      "database_id": "0652fb68-4d3e-4fab-bc93-e2f5ed717389",
      "migrations_dir": "drizzle"
    }
  ]
}
